"""
LeetCode 35: Search Insert Position
Return the index of target in a sorted array, or the index where it
would be inserted to keep the array sorted.

Approach: standard binary search. If the loop ends without finding the
target, `left` has naturally converged to the correct insertion point.

Time: O(log n)   Space: O(1)
"""

from typing import List


class Solution:
    def searchInsert(self, nums: List[int], target: int) -> int:
        left = 0
        right = len(nums) - 1

        while left <= right:
            mid = (left + right) // 2
            if nums[mid] == target:
                return mid
            elif nums[mid] < target:
                left = mid + 1
            else:
                right = mid - 1

        return left
