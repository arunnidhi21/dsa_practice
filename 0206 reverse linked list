"""
LeetCode 206: Reverse Linked List
Reverse a singly linked list in place and return the new head.

Approach: walk through the list once, flipping each node's `next`
pointer to point backward instead of forward. Save the original
`next` node before flipping, or the rest of the list is lost.

Time: O(n)   Space: O(1)
"""


class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next


class Solution:
    def reverseList(self, head):
        prev = None
        current = head

        while current:
            next_node = current.next
            current.next = prev
            prev = current
            current = next_node

        return prev
