"""
LeetCode 121: Best Time to Buy and Sell Stock
Given daily stock prices, find the max profit from one buy + one sell
(buy must happen before sell). Return 0 if no profit is possible.

Approach: single pass, tracking two running values:
  - lowest price seen so far (best possible buy day)
  - best profit seen so far (today's price - lowest so far, if better)

Time: O(n)   Space: O(1)
"""

from typing import List


class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        lowest = prices[0]
        best_profit = 0
        for price in prices:
            if price < lowest:
                lowest = price
            profit = price - lowest
            if profit > best_profit:
                best_profit = profit
        return best_profit
