"""
LeetCode 238: Product of Array Except Self
Return an array where each element is the product of all other
elements, without using division.

Approach: two passes. First pass (left to right) fills each position
with the product of everything to its left (prefix product). Second
pass (right to left) multiplies in the product of everything to its
right (suffix product).

Time: O(n)   Space: O(1) extra (output array doesn't count)
"""

from typing import List


class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:
        n = len(nums)
        result = [1] * n

        prefix = 1
        for i in range(n):
            result[i] = prefix
            prefix *= nums[i]

        suffix = 1
        for i in range(n - 1, -1, -1):
            result[i] *= suffix
            suffix *= nums[i]

        return result
