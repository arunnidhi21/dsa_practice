"""
LeetCode 977: Squares of a Sorted Array
Given a sorted array (may include negatives), return the squares of
each element, sorted ascending.

Approach: two pointers from both ends. The largest square always
comes from one of the two extremes (most negative or most positive),
so compare both ends and place the bigger square at the back of the
result array, working inward.

Time: O(n)   Space: O(n) for the result array
"""

from typing import List


class Solution:
    def sortedSquares(self, nums: List[int]) -> List[int]:
        n = len(nums)
        result = [0] * n
        left, right = 0, n - 1
        pos = n - 1

        while left <= right:
            left_sq = nums[left] ** 2
            right_sq = nums[right] ** 2
            if left_sq > right_sq:
                result[pos] = left_sq
                left += 1
            else:
                result[pos] = right_sq
                right -= 1
            pos -= 1

        return result
