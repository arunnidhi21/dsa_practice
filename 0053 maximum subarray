"""
LeetCode 53: Maximum Subarray (Kadane's Algorithm)
Find the contiguous subarray with the largest sum, return that sum.

Approach: track a running current_sum. At each number, decide whether
to extend the current run or start fresh from this number (whichever
gives a bigger sum). Track the best sum seen across all positions.

Time: O(n)   Space: O(1)
"""

from typing import List


class Solution:
    def maxSubArray(self, nums: List[int]) -> int:
        current_sum = nums[0]
        best_sum = nums[0]

        for num in nums[1:]:
            current_sum = max(num, current_sum + num)
            best_sum = max(best_sum, current_sum)

        return best_sum
