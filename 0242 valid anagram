"""
LeetCode 242: Valid Anagram
Return True if string t is an anagram of string s (same letters, same
counts, any order).

Approach: count letter frequencies in s into a hash map, then subtract
frequencies while scanning t. If any letter in t isn't in the map, or
any count is left over (non-zero) at the end, it's not an anagram.

Time: O(n)   Space: O(n)
"""


class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        if len(s) != len(t):
            return False

        count = {}
        for char in s:
            if char in count:
                count[char] += 1
            else:
                count[char] = 1

        for char in t:
            if char in count:
                count[char] -= 1
            else:
                return False

        for value in count.values():
            if value != 0:
                return False

        return True
