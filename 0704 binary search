"""
LeetCode 704: Binary Search
Given a sorted array and a target, return its index, or -1 if not found.

Approach: repeatedly check the middle element and cut the search space
in half based on whether it's too big or too small.

Time: O(log n)   Space: O(1)
"""

from typing import List


class Solution:
    def search(self, nums: List[int], target: int) -> int:
        left = 0
        right = len(nums) - 1

        while left <= right:
            mid = (left + right) // 2
            if nums[mid] == target:
                return mid
            elif nums[mid] < target:
                left = mid + 1
            else:
                right = mid - 1

        return -1
